{
  "name": "@checkpoint-a11y/runner",
  "version": "0.1.0",
  "description": "Runs accessibility checks at checkpoints in Playwright user flows and gates pull requests on new issues.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "checkpoint-a11y": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/playwright.ts --format esm --dts --clean --target node20",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@checkpoint-a11y/core": "workspace:*",
    "@axe-core/playwright": "^4.10.2",
    "axe-core": "^4.10.3",
    "jiti": "^2.5.1",
    "playwright": "^1.56.0",
    "tinyglobby": "^0.2.15"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therufet721/checkpoint-a11y.git",
    "directory": "packages/runner"
  },
  "homepage": "https://github.com/therufet721/checkpoint-a11y#readme",
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "playwright",
    "ci",
    "eaa"
  ],
  "publishConfig": {
    "access": "public"
  }
}
